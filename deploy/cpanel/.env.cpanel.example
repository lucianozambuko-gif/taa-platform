# Training Africa Academy platform: settings for cPanel.
# Copy this file to ".env" in the app folder (next to app.js) and fill it in,
# or enter the same names and values under "Environment variables" in Setup Node.js App.
# Values entered in cPanel win over this file. Restart the app after any change.

# ---------- Required ----------

# The address the site runs at, with https and no trailing slash.
# Change it when you move from the test subdomain to the main domain; no rebuild needed.
SITE_URL=https://new.trainingafricaacademy.co.za

# Supabase (Project Settings > API). The URL and anon key are also built into the
# browser code, so they must match the project the package was built for.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never share it or put it in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PayFast. Use "sandbox" while testing, then "live" with the live merchant details.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Must be false on the live site.
ALLOW_SANDBOX_SIMULATION=false

# Shared secret for the scheduled jobs (/api/cron/hourly, daily, monthly).
# Use a long random value, and the same value in the cron set-up.
CRON_SECRET=

# ---------- Lesson videos: Bunny Stream ----------
# Bunny dashboard > Stream > your video library.
# API tab: the library ID and the library API key (server only, never shared).
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Security tab > "Embed view token authentication" switched on: the token authentication key.
# Learners then get player links that expire, made only for enrolled learners.
BUNNY_STREAM_TOKEN_KEY=
# API tab > CDN hostname (e.g. vz-abc12345-678.b-cdn.net). Needed for "Save video to this phone"
# (switch on MP4 fallback in the Encoding tab) and video thumbnails.
BUNNY_STREAM_CDN_HOST=
# Only if CDN token authentication is switched on for the library's pull zone.
BUNNY_CDN_TOKEN_KEY=

# ---------- Email (Resend) ----------
RESEND_API_KEY=
NOTIFY_FROM=Training Africa Academy <noreply@trainingafricaacademy.co.za>
STAFF_NOTIFY_EMAIL=
MANAGEMENT_REPORT_EMAIL=

# ---------- WhatsApp ----------
# Click-to-chat number in international format without + (e.g. 27821234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# WhatsApp Cloud API (optional, for automated messages)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# ---------- Optional ----------
# Google Analytics 4 (G-XXXXXXX) and Search Console verification
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=
# AI course advisor
ANTHROPIC_API_KEY=
ADVISOR_MODEL=
# Corporate brochure link (defaults to /corporate-brochure.pdf)
NEXT_PUBLIC_CORPORATE_BROCHURE_URL=
# Zero-rated (data-free) mirror, if one is set up
NEXT_PUBLIC_DATAFREE_URL=
NEXT_PUBLIC_DATAFREE_HOST=
# Test recipients for notification checks
NOTIFY_TEST_TO=
NOTIFY_TEST_TO_PHONE=
