# Public site URL (no trailing slash). PayFast return/cancel/notify URLs are built from it.
# Read when the server starts, so it can change without a rebuild. SITE_URL also works.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Never expose to the browser. Used to confirm payments and enrol learners.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PayFast. Sandbox values from your own sandbox account at https://sandbox.payfast.co.za
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Demo safety net: shows a "Simulate payment confirmation" button on the payment
# return page when PayFast cannot reach the notify URL (e.g. running on localhost).
# Must be false in production.
ALLOW_SANDBOX_SIMULATION=true

# WhatsApp Business number in international format without + (e.g. 27821234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Google Analytics 4 measurement ID (optional), e.g. G-XXXXXXX
NEXT_PUBLIC_GA_ID=

# ---------- Lesson videos: Bunny Stream ----------
# Bunny dashboard > Stream > your video library.
# API tab: the library ID and the library API key (server only, never shared).
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Security tab > "Embed view token authentication" switched on: the token authentication key.
# Learners then get player links that expire, made only for enrolled learners.
BUNNY_STREAM_TOKEN_KEY=
# API tab > CDN hostname (e.g. vz-abc12345-678.b-cdn.net). Needed for "Save video to this phone"
# (switch on MP4 fallback in the Encoding tab) and video thumbnails.
BUNNY_STREAM_CDN_HOST=
# Only if CDN token authentication is switched on for the library's pull zone.
BUNNY_CDN_TOKEN_KEY=
