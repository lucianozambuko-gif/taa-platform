# Public site URL (no trailing slash). PayFast return/cancel/notify URLs are built from it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Never expose to the browser. Used to confirm payments and enrol learners.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PayFast. Sandbox values from your own sandbox account at https://sandbox.payfast.co.za
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Demo safety net: shows a "Simulate payment confirmation" button on the payment
# return page when PayFast cannot reach the notify URL (e.g. running on localhost).
# Must be false in production.
ALLOW_SANDBOX_SIMULATION=true

# WhatsApp Business number in international format without + (e.g. 27821234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Google Analytics 4 measurement ID (optional), e.g. G-XXXXXXX
NEXT_PUBLIC_GA_ID=
